{
    "name": "wage-sum-angular-ui",
    "version": "0.0.202608",
    "scripts": {
        "ng": "ng",
        "generate:api": "openapi-generator-cli generate -g typescript-angular -i https://raw.githubusercontent.com/lsmhun/wage-sum-server/main/api/wagesum-openapi.yaml -o ./build/openapi",
        "prestart": "npm run generate:api",
        "start": "ng serve",
        "pre-build": "npm run generate:api",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "pretest": "npm run generate:api",
        "test": "ng test",
        "test:coverage": "ng test --coverage",
        "lint": "ng lint"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.0.0",
        "@angular/cdk": "^22.0.0",
        "@angular/common": "^22.0.0",
        "@angular/compiler": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@angular/material": "^22.0.0",
        "@angular/platform-browser": "^22.0.0",
        "@angular/platform-browser-dynamic": "^22.0.0",
        "@angular/router": "^22.0.0",
        "@openapitools/openapi-generator-cli": "^2.17.0",
        "rxjs": "~7.5.0",
        "tslib": "^2.3.0",
        "typeface-roboto": "^1.1.13",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular-builders/jest": "^22.0.0",
        "@angular-eslint/builder": "^22.0.0",
        "@angular-eslint/eslint-plugin": "^22.0.0",
        "@angular-eslint/eslint-plugin-template": "^22.0.0",
        "@angular-eslint/schematics": "^22.0.0",
        "@angular-eslint/template-parser": "^22.0.0",
        "@angular/build": "^22.0.0",
        "@angular/cli": "^22.0.0",
        "@angular/compiler-cli": "^22.0.0",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "angular-eslint": "^22.1.0",
        "eslint": "^9.0.0",
        "https-proxy-agent": "^9.1.0",
        "jest": "^30.0.0",
        "jest-environment-jsdom": "^30.0.0",
        "jest-preset-angular": "^16.0.0",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.66.0"
    }
}
